# OS / Python
.DS_Store
__pycache__/
*.pyc

# Generated workflow outputs (re-renderable; inputs like sample_inputs/ and tracks/ stay tracked)
workflows/*/outputs/

# 05 rap battle: rendered clips & masters (episode.json, refs/, cover/, song and work/*.json stay tracked)
workflows/05_ancient_rap_battle/episodes/*/clips/
workflows/05_ancient_rap_battle/episodes/*/final/
workflows/05_ancient_rap_battle/episodes/*/preview/
workflows/05_ancient_rap_battle/episodes/*/work/**/*.wav
workflows/05_ancient_rap_battle/episodes/*/work/**/*.mp4
workflows/05_ancient_rap_battle/episodes/*/work/**/*.png
workflows/05_ancient_rap_battle/episodes/*/work/package/
# local take backups from re-render rounds (clips_v1/ v2/ v3/, final_v1/)
workflows/05_ancient_rap_battle/episodes/*/clips_v*/
workflows/05_ancient_rap_battle/episodes/*/final_v*/
# Shorts mini-episodes: keep episode.json + work/*.json, everything else is cut / copied / rendered
workflows/05_ancient_rap_battle/episodes/*/shorts/*/clips/
workflows/05_ancient_rap_battle/episodes/*/shorts/*/final/
workflows/05_ancient_rap_battle/episodes/*/shorts/*/preview/
workflows/05_ancient_rap_battle/episodes/*/shorts/*/refs/
workflows/05_ancient_rap_battle/episodes/*/shorts/*/work/**/*.wav
workflows/05_ancient_rap_battle/episodes/*/shorts/*/work/**/*.png
workflows/05_ancient_rap_battle/episodes/*/cover/frame.png
# channel art is regenerated by channel/make_brand_assets.py
workflows/05_ancient_rap_battle/channel/out/

# Cloud TTS takes pulled back by scripts/run_cloud_tts_remote.py
tts_takes/

# Auto-downloaded font caches
.cache/
